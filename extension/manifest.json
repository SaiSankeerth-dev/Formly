{
  "manifest_version": 3,
  "name": "Seva Saarthi",
  "version": "2.2.0",
  "description": "Citizen-controlled assistance on verified official government portals.",
  "permissions": ["activeTab", "storage", "sidePanel", "scripting"],
  "host_permissions": [
    "https://*.gov.in/*",
    "https://*.nic.in/*",
    "https://*.cgg.gov.in/*",
    "https://scholarships.gov.in/*",
    "https://onlineservices.proteantech.in/*",
    "https://www.pan.utiitsl.com/*",
    "https://pan.utiitsl.com/*",
    "https://www.incometax.gov.in/*",
    "https://incometax.gov.in/*",
    "https://myaadhaar.uidai.gov.in/*",
    "https://uidai.gov.in/*",
    "https://www.uidai.gov.in/*",
    "https://voters.eci.gov.in/*",
    "https://eci.gov.in/*",
    "https://www.passportindia.gov.in/*",
    "https://services1.passportindia.gov.in/*",
    "https://passportindia.gov.in/*",
    "https://sarathi.parivahan.gov.in/*",
    "https://parivahan.gov.in/*",
    "https://serviceonline.gov.in/*",
    "https://www.digilocker.gov.in/*",
    "https://digilocker.gov.in/*",
    "https://www.telangana.gov.in/*",
    "https://telangana.gov.in/*",
    "https://ts.meeseva.telangana.gov.in/*",
    "https://telanganaepass.cgg.gov.in/*",
    "https://cgg.gov.in/*",
    "https://*.vercel.app/*",
    "https://seva-saarthi.vercel.app/*",
    "https://sevasaarthi.vercel.app/*",
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*"
  ],
  "background": { "service_worker": "background.js", "type": "module" },
  "side_panel": { "default_path": "sidepanel.html" },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Seva Saarthi",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.gov.in/*",
        "https://*.nic.in/*",
        "https://*.cgg.gov.in/*",
        "https://scholarships.gov.in/*",
        "https://onlineservices.proteantech.in/*",
        "https://www.pan.utiitsl.com/*",
        "https://pan.utiitsl.com/*",
        "https://www.incometax.gov.in/*",
        "https://incometax.gov.in/*",
        "https://myaadhaar.uidai.gov.in/*",
        "https://uidai.gov.in/*",
        "https://www.uidai.gov.in/*",
        "https://voters.eci.gov.in/*",
        "https://eci.gov.in/*",
        "https://www.passportindia.gov.in/*",
        "https://services1.passportindia.gov.in/*",
        "https://passportindia.gov.in/*",
        "https://sarathi.parivahan.gov.in/*",
        "https://parivahan.gov.in/*",
        "https://serviceonline.gov.in/*",
        "https://www.digilocker.gov.in/*",
        "https://digilocker.gov.in/*",
        "https://www.telangana.gov.in/*",
        "https://telangana.gov.in/*",
        "https://ts.meeseva.telangana.gov.in/*",
        "https://telanganaepass.cgg.gov.in/*",
        "https://cgg.gov.in/*",
        "http://localhost:3000/*",
        "http://127.0.0.1:3000/*"
      ],
      "js": ["page-analyzer.js", "policy-engine.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "https://*.vercel.app/*",
        "https://seva-saarthi.vercel.app/*",
        "https://sevasaarthi.vercel.app/*",
        "http://localhost:3000/*",
        "http://127.0.0.1:3000/*"
      ],
      "js": ["webapp-bridge.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
