{
  "manifest_version": 3,
  "name": "Seva Saarthi — Government Application Assistant",
  "version": "1.0.2",
  "description": "A citizen-controlled browser assistant for discovering and completing official government applications.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*",
    "https://onlineservices.nsdl.com/*",
    "https://*.incometax.gov.in/*",
    "https://*.tg.meeseva.gov.in/*",
    "https://*.sarathi.parivahan.gov.in/*",
    "https://pmkisan.gov.in/*",
    "https://scholarships.gov.in/*",
    "https://myaadhaar.uidai.gov.in/*",
    "https://*.digilocker.gov.in/*",
    "https://beneficiary.nha.gov.in/*",
    "https://*.epds.telangana.gov.in/*",
    "https://*.dharani.telangana.gov.in/*",
    "https://*.ghmc.gov.in/*",
    "https://udyamregistration.gov.in/*",
    "https://*.employment.telangana.gov.in/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Seva Saarthi Assistant"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:3000/*",
        "http://127.0.0.1:3000/*",
        "https://onlineservices.nsdl.com/*",
        "https://*.incometax.gov.in/*",
        "https://*.tg.meeseva.gov.in/*",
        "https://*.sarathi.parivahan.gov.in/*",
        "https://pmkisan.gov.in/*",
        "https://scholarships.gov.in/*",
        "https://myaadhaar.uidai.gov.in/*",
        "https://*.digilocker.gov.in/*",
        "https://beneficiary.nha.gov.in/*",
        "https://*.epds.telangana.gov.in/*",
        "https://*.dharani.telangana.gov.in/*",
        "https://*.ghmc.gov.in/*",
        "https://udyamregistration.gov.in/*",
        "https://*.employment.telangana.gov.in/*"
      ],
      "exclude_matches": [
        "*://*.google.com/recaptcha/*",
        "*://*.recaptcha.net/*",
        "*://*.hcaptcha.com/*",
        "*://challenges.cloudflare.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_end",
      "all_frames": false
    }
  ],
  "commands": {
    "autofill_page": {
      "suggested_key": {
        "default": "Alt+Shift+F",
        "mac": "Alt+Shift+F"
      },
      "description": "Assist with the current official government page using Seva Saarthi"
    }
  }
}
